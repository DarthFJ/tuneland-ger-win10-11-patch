+/* Unicode variants: Wine's 16-bit MMSYSTEM (used by otvdm) calls these instead of the A versions */
+MCIERROR WINAPI fake_mciSendCommandW(MCIDEVICEID IDDevice, UINT uMsg, DWORD_PTR fdwCommand, DWORD_PTR dwParam)
+{
+	dprintf("mciSendCommandW(IDDevice=%p, uMsg=%p, fdwCommand=%p, dwParam=%p)\n", IDDevice, uMsg, fdwCommand, dwParam);
+
+	if (uMsg == MCI_OPEN) {
+		LPMCI_OPEN_PARMSW parms = (LPVOID)dwParam;
+		int isCD = 0;
+
+		if (fdwCommand & MCI_OPEN_TYPE_ID) {
+			isCD = LOWORD(parms->lpstrDeviceType) == MCI_DEVTYPE_CD_AUDIO;
+		} else if (fdwCommand & MCI_OPEN_TYPE) {
+			isCD = parms->lpstrDeviceType && _wcsicmp(parms->lpstrDeviceType, L"cdaudio") == 0;
+		}
+
+		if (isCD) {
+			dprintf("  MCI_OPEN (W) -> magic device id for cdaudio\n");
+			if (fdwCommand & MCI_OPEN_ALIAS && parms->lpstrAlias) {
+				WideCharToMultiByte(CP_ACP, 0, parms->lpstrAlias, -1, alias_s, sizeof(alias_s), NULL, NULL);
+			}
+			if (fdwCommand & MCI_NOTIFY) {
+				SendNotifyMessageA((HWND)parms->dwCallback, MM_MCINOTIFY, MCI_NOTIFY_SUCCESSFUL, MAGIC_DEVICEID);
+			}
+			parms->wDeviceID = MAGIC_DEVICEID;
+			return 0;
+		}
+		return relay_mciSendCommandW(IDDevice, uMsg, fdwCommand, dwParam);
+	}
+
+	if (IDDevice != MAGIC_DEVICEID) {
+		return relay_mciSendCommandW(IDDevice, uMsg, fdwCommand, dwParam);
+	}
+
+	/* Commands returning strings need a converted buffer, all others share the A layout */
+	if (uMsg == MCI_INFO || uMsg == MCI_SYSINFO) {
+		LPMCI_INFO_PARMSW parms = (LPVOID)dwParam;
+		char buf[256] = {0};
+		MCI_INFO_PARMSA a = { parms->dwCallback, buf, sizeof(buf) };
+
+		if (uMsg == MCI_SYSINFO && fdwCommand & MCI_SYSINFO_QUANTITY) {
+			*(DWORD*)parms->lpstrReturn = 1;
+			return 0;
+		}
+		fake_mciSendCommandA(IDDevice, uMsg, fdwCommand, (DWORD_PTR)&a);
+		if (parms->lpstrReturn && parms->dwRetSize) {
+			MultiByteToWideChar(CP_ACP, 0, buf, -1, parms->lpstrReturn, parms->dwRetSize);
+		}
+		return 0;
+	}
+
+	return fake_mciSendCommandA(IDDevice, uMsg, fdwCommand, dwParam);
+}
+
+MCIERROR WINAPI fake_mciSendStringW(LPCWSTR cmd, LPWSTR ret, UINT cchReturn, HWND hwndCallback)
+{
+	char cmdA[1000], retA[1000] = {0}, lower[1000];
+
+	if (!cmd || !WideCharToMultiByte(CP_ACP, 0, cmd, -1, cmdA, sizeof(cmdA), NULL, NULL)) {
+		return relay_mciSendStringW(cmd, ret, cchReturn, hwndCallback);
+	}
+	dprintf("[MCI String W = %s]\n", cmdA);
+
+	/* Only take over strings aimed at the CD device, everything else goes to the real winmm */
+	strcpy(lower, cmdA);
+	for (int i = 0; lower[i]; i++) lower[i] = tolower(lower[i]);
+	if (!strstr(lower, "cdaudio") && !strstr(lower, alias_s)) {
+		return relay_mciSendStringW(cmd, ret, cchReturn, hwndCallback);
+	}
+
+	MCIERROR err = fake_mciSendStringA(cmdA, retA, sizeof(retA), hwndCallback);
+	if (ret && cchReturn) {
+		MultiByteToWideChar(CP_ACP, 0, retA, -1, ret, cchReturn);
+	}
+	return err;
+}
